{
  "name": "Wereldpost",
  "tree": {
    "$className": "DataModel",
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingEnabled": false
      },
      "Wereldpost": {
        "$className": "Folder",
        "Floor": {
          "$className": "Part",
          "$properties": {
            "Anchored": true,
            "Size": [240, 2, 240],
            "Position": [0, -1, 0],
            "Color": [0.851, 0.816, 0.745],
            "Material": "SmoothPlastic",
            "TopSurface": "Smooth",
            "BottomSurface": "Smooth"
          }
        },
        "Spawn": {
          "$className": "SpawnLocation",
          "$properties": {
            "Anchored": true,
            "Size": [12, 1, 12],
            "Position": [0, 0.5, 0],
            "Color": [0.353, 0.451, 0.353],
            "Material": "SmoothPlastic",
            "TopSurface": "Smooth",
            "BottomSurface": "Smooth"
          }
        }
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Ambient": [0.431, 0.424, 0.408],
        "OutdoorAmbient": [0.549, 0.541, 0.518],
        "Brightness": 2.2,
        "ClockTime": 14.5,
        "GeographicLatitude": 52
      }
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$path": "src/client"
        }
      }
    }
  }
}
